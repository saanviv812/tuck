{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tuck",
  "version": "0.1.0",
  "identifier": "app.tuck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "capture",
        "title": "Tuck a thought",
        "url": "windows/capture/index.html",
        "width": 480,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "tuck: catch thoughts before they fly off",
    "longDescription": "Press a shortcut, type a thought, press Enter. A little pixel buddy keeps it safe on your computer.",
    "copyright": "© 2026 Saanvi Varma",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Saanvi Varma",
    "homepage": "https://saanviv812.github.io/tuck/"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMzJERTU0NThDNThBMjcKUldRbmlzVllWTjR5YnQ1ZGd2NTBySnJvbDhXM3htMG54REx5U0c3QkR6Wm9FQXhuWlF0TGxDZXEK",
      "endpoints": [
        "https://github.com/saanviv812/tuck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}